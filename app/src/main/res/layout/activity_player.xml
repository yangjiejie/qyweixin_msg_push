<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- 视频 View -->
    <com.videowatch.app.player.ZoomableVideoView
        android:id="@+id/videoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true" />

    <!-- 顶部控制栏 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_gravity="top"
        android:background="@drawable/gradient_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingTop="24dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back"
            android:scaleType="centerInside" />

        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:layout_marginHorizontal="8dp" />

        <!-- 比例模式 -->
        <TextView
            android:id="@+id/btnAspectRatio"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="适应"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:background="@drawable/bg_speed_btn"
            android:clickable="true"
            android:focusable="true" />

        <!-- 旋转屏幕 -->
        <ImageButton
            android:id="@+id/btnRotate"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_rotate"
            android:contentDescription="旋转屏幕"
            android:scaleType="centerInside" />

        <!-- 删除当前视频 -->
        <ImageButton
            android:id="@+id/btnDelete"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_delete"
            android:contentDescription="删除"
            android:scaleType="centerInside" />
    </LinearLayout>

    <!-- 底部控制栏 -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/gradient_bottom"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <!-- 进度条 -->
        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginHorizontal="4dp"
            android:max="1000"
            android:progressDrawable="@drawable/progress_bar_horizontal"
            android:thumb="@drawable/thumb_progress"
            android:splitTrack="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <!-- 播放/暂停 -->
            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_pause"
                android:contentDescription="@string/pause"
                android:scaleType="centerInside" />

            <!-- 时间 -->
            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp"
                android:text="00:00 / 00:00"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- 逐帧后退 -->
            <ImageButton
                android:id="@+id/btnFrameBackward"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_frame_backward"
                android:contentDescription="@string/frame_backward"
                android:scaleType="centerInside"
                android:visibility="gone" />

            <!-- 逐帧前进 -->
            <ImageButton
                android:id="@+id/btnFrameForward"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_frame_forward"
                android:contentDescription="@string/frame_forward"
                android:scaleType="centerInside"
                android:visibility="gone" />

            <!-- 截屏 -->
            <ImageButton
                android:id="@+id/btnScreenshot"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_screenshot"
                android:contentDescription="@string/screenshot"
                android:scaleType="centerInside" />

            <!-- GIF -->
            <ImageButton
                android:id="@+id/btnGif"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_gif"
                android:contentDescription="@string/capture_gif"
                android:scaleType="centerInside" />

            <!-- AB循环: 2个独立按钮 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnSetA"
                    android:layout_width="32dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="A"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_control_btn"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnSetB"
                    android:layout_width="32dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="B"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_control_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginStart="2dp" />

                <!-- 清除AB (AB启用时才显示) -->
                <TextView
                    android:id="@+id/btnClearAB"
                    android:layout_width="28dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="×"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:background="@drawable/bg_control_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone"
                    android:layout_marginStart="2dp" />
            </LinearLayout>

            <!-- 倍速（弹出选择） -->
            <TextView
                android:id="@+id/btnSpeed"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="1x"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_speed_btn"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginStart="2dp" />

            <!-- 单视频循环 -->
            <ImageButton
                android:id="@+id/btnSingleLoop"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_loop_active"
                android:contentDescription="@string/single_loop"
                android:scaleType="centerInside" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
